# FlowTXT production environment contract.
# Copy to deploy/.env and fill in real values. deploy/.env is gitignored.
# Every variable below is required by application-prod.yaml and enforced at
# boot by StartupConfigValidator.

# Spring profile MUST be prod so the strict rules apply.
SPRING_PROFILES_ACTIVE=prod

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000

# PostgreSQL (managed service or the bundled compose service)
DATABASE_URL=jdbc:postgresql://postgres:5432/flowtxt
DB_USERNAME=flowtxt
DB_PASSWORD=replace-with-a-strong-db-password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Login rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=20
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_PATHS=/auth/login
RATE_LIMIT_CLIENT_IP_HEADER=X-Forwarded-For

# Image to deploy (immutable tag from CI; never :edge/:latest)
IMAGE_TAG=sha-0000000
